# Copy this file to .env and edit with your API keys. Everything is optional.

# LLM provider for highlight selection: ollama (offline, default) | gemini | groq
LLM_PROVIDER=gemini

# Fallback provider: if the primary fails (429/503/etc.), retry with this one
LLM_FALLBACK=groq

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Gemini (free API key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (free API key from https://console.groq.com) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- NVIDIA Nemotron (free API key from https://build.nvidia.com) ---
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Whisper model: tiny | base | small | medium | large-v3
WHISPER_MODEL=small

# Background job workers (1 or 2)
MAX_WORKERS=1
